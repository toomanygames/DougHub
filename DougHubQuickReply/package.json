{
  "name": "douqhub-quick-reply",
  "version": "1.0.0",
  "description": "DougHub desktop notifications and quick replies",
  "main": "main.js",
  "author": "DougHub",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "online.doughub.quickreply",
    "productName": "DougHub Quick Reply",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "popup.html",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "DougHub-Quick-Reply-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}